      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:5173/*"
      ],
      "webOrigins": [
        "http://localhost:5173"
      ],
      "rootUrl": "http://localhost:5173"
    },
    {
      "clientId": "identity-bridge",
      "name": "MyFarm identity bridge (services/api, server-side only)",
      "enabled": true,
      "publicClient": false,
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": true,
      "secret": "myfarm-identity-bridge-secret",
      "redirectUris": [],
      "webOrigins": []
    }
  ],
  "users": [
    {
      "username": "admin",
      "enabled": true,
      "emailVerified": false,
      "credentials": [
        {
          "type": "password",
          "value": "ChangeMeOnFirstLogin!",
          "temporary": true
        }
      ],
      "requiredActions": [
        "UPDATE_PASSWORD",
        "CONFIGURE_TOTP"
      ],
      "realmRoles": [
        "admin"
      ],
      "firstName": "MyFarm",
      "lastName": "Admin"
    },
    {
      "username": "qa-admin",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "qa-admin-test-password",
          "temporary": false
        }
      ],
      "requiredActions": [],
      "realmRoles": [
        "admin"
      ],
      "attributes": {
        "note": [
          "automated-test-fixture-only"
        ]
      },
      "firstName": "QA",
      "lastName": "Admin"
    },
    {
      "username": "service-account-identity-bridge",
      "enabled": true,
      "serviceAccountClientId": "identity-bridge",
      "clientRoles": {
        "realm-management": [
          "realm-admin"
        ]
      }
    }
  ],
  "requiredActions": [
    {
      "alias": "VERIFY_PROFILE",
      "name": "Verify Profile",
      "providerId": "VERIFY_PROFILE",
      "enabled": false,
      "defaultAction": false,
      "priority": 90,
      "config": {}
    }
