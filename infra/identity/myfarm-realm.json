{
  "realm": "myfarm",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "roles": {
    "realm": [
      {
        "name": "customer",
        "description": "MyFarm customer, authenticated via phone OTP"
      },
      {
        "name": "admin",
        "description": "MyFarm administrator / back-office staff"
      }
    ]
  },
  "clients": [
    {
      "clientId": "storefront-web",
